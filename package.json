{
  "name": "dsh-codex-approval",
  "version": "0.4.6",
  "description": "Codex-style approval autopilot for DeepSeek Harness: ordered glob rules (allow/ask/deny) plus an AI risk judge (low/medium/high) mapped through a risk tolerance, as an approval answerer.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "rules.js",
    "shell-shape.js",
    "redact.js",
    "enrich.js",
    "evidence.js",
    "command-facts.js",
    "i18n.js",
    "judge.js",
    "modes.js",
    "transcript.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1",
      "dshReleases": {
        "0.1.0-rc.6": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "codex",
    "risk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/040822/dsh-codex-approval.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
